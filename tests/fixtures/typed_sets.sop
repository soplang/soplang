hawl hubi(v,name){haddii(!v){tuur name}}
hawl fails(cb,code="E039"){door failed=been tijaabi{cb()}qabo(e,x){failed=run hubi(x.summad==code,"error code")}hubi(failed,"expected failure")}
urur[abn] ints=urur(1,2)
door alias=ints
alias.geli(3)
fails(hawl(){alias.geli("bad")})
fails(hawl(){alias.geli(1.0)})
fails(hawl(){alias.geli([])},"E041")
hubi(ints.teed()==[1,2,3],"failed insertion is atomic")
hubi(ints.saar(2)==2 && ints.saar(9)==maran,"checked removal")
ints.geli(2)
hubi(ints.teed()==[1,3,2],"remove and reinsert order")
urur[jajab] decimals=urur(1.0)
fails(hawl(){decimals.geli(1)})
hubi(decimals==urur(1.0),"no element numeric conversion")
urur[maran] nulls=urur(maran)
fails(hawl(){nulls.geli(been)})
hubi(nulls.leeyahay(maran) && nulls.saar(maran)==maran && !nulls.leeyahay(maran),"null keys")
urur[abn|qoraal] mixed=urur(1,"x")
urur[qoraal|abn] equivalent=mixed
equivalent.geli(2).geli("y")
fails(hawl(){mixed.geli(run)})
hubi(mixed==urur(1,2,"x","y"),"equivalent union contracts")
urur[abn|teed] limited=urur(1)
fails(hawl(){limited.geli([])},"E041")
urur[xirmo[abn,qoraal?]] rows=urur(xirmo(1,"a"),xirmo(2,maran))
rows.geli(xirmo(3,"b"))
fails(hawl(){rows.geli(xirmo(1))})
fails(hawl(){rows.geli(xirmo(1.0,"a"))})
fails(hawl(){rows.geli(xirmo(1,run))})
fails(hawl(){rows.geli(xirmo(1,[]))},"E041")
door sums=0
kuceli(n,label ku rows){sums=sums+n}
hubi(sums==6,"typed tuple rows")
urur[xirmo[]] emptyrows=urur(xirmo())
fails(hawl(){emptyrows.geli(xirmo(1))})
urur[xirmo] anyrows=urur(xirmo(),xirmo(1,"x"))
hubi(anyrows.dherer()==2,"bare tuple keys")
urur[abn]? optional=maran
optional=urur(9)
fails(hawl(){optional.geli("bad")})
optional=maran
hubi(optional==maran,"nullable typed set")
door source=urur(1)
teed[urur[abn]] list=[source]
walax[qoraal,urur[abn]] object={key:source}
xirmo[urur[abn]] tuple=xirmo(source)
source.geli(2)
fails(hawl(){source.geli("bad")})
fails(hawl(){list.geli(urur("bad"))})
fails(hawl(){object.key=urur("bad")})
hubi(source==urur(1,2) && list[0]==source && object.key==source && tuple[0]==source,"all parent guards")
door shared=urur()
teed[urur[abn]] parentints=[shared]
teed[urur[qoraal]] parentstrings=[shared]
fails(hawl(){shared.geli(1)})
fails(hawl(){shared.geli("x")})
hubi(shared==urur(),"intersection of parent contracts")
parentstrings[0]=urur("replacement")
shared.geli(1)
fails(hawl(){shared.geli("x")})
hubi(shared==urur(1),"replaced dependency detaches")
door correlated=urur()
teed[urur[abn]]|teed[urur[qoraal]] whole=[correlated]
correlated.geli("a")
fails(hawl(){correlated.geli(1)})
correlated.nadiifi().geli(1)
fails(hawl(){correlated.geli("a")})
hubi(correlated==urur(1),"whole container union changes branch atomically")
door copied=ints.nuqul()
copied.geli("untyped")
door merged=ints.midee(urur("new"))
merged.geli(run)
hubi(!ints.leeyahay("untyped") && !ints.leeyahay("new"),"fresh results have independent guards")
urur[abn] accepted=ints.wadaag(urur(1,"x"))
hubi(accepted==urur(1),"algebra result checked by annotation")
hawl makebad(){celi urur("bad")}
hawl badreturn():urur[abn]{celi makebad()}
fails(hawl(){badreturn()},"E022")
urur[abn] previous=urur(7)
fails(hawl(){previous=makebad()},"E022")
hubi(previous==urur(7),"failed assignment preserves binding")
hawl f(urur[abn] values=urur()):urur[abn]{values.geli(1) celi values}
hubi(f()==urur(1) && f()==urur(1) && f(values:urur(2))==urur(2,1),"typed defaults and named arguments")
door dynamic=f
fails(hawl(){dynamic(urur("bad"))},"E022")
fails(hawl(){dynamic(urur(1.0))},"E022")
fails(hawl(){dynamic([])},"E022")
door passed=urur(3)
dynamic(passed)
fails(hawl(){passed.geli("bad")})
hawl collect(teed[urur[abn]] *items,walax[urur[abn]] **options){celi [items,options]}
door packed=collect(urur(1),a:urur(2))
fails(hawl(){packed[0][0].geli("bad")})
fails(hawl(){packed[1].a.geli("bad")})
hawl outer(seed){celi hawl(urur[abn] input=urur(seed)):urur[abn]{celi input}}
door closure=outer(4)
hubi(closure()==urur(4),"captured typed default")
fails(hawl(){closure(urur("bad"))},"E022")
qaab Holder{hawl dhaw(urur[abn] input){nafta.data=input} hawl get():urur[abn]{celi nafta.data}}
door held=cusub Holder(urur(5))
fails(hawl(){held.get().geli("bad")})
urur[abn] iteration=urur(1,2)
door cursor=iteration.wareeg()
iteration.nadiifi()
hubi(cursor.urur()==urur(1,2),"typed snapshot survives clear")
iteration.geli(3)
fails(hawl(){iteration.geli("bad")})
madoor urur[abn] constant=urur(1)
constant.geli(2)
hubi(constant==urur(1,2),"constant binding retains mutable membership")
kuceli(i ku baaxad(0,1600)){door garbage=xirmo(urur(xirmo(i))); [garbage]}
fails(hawl(){rows.geli(xirmo(9,been))})
fails(hawl(){source.geli("bad")})
hubi(rows.dherer()==3 && ints==urur(1,3,2),"GC retains guards and values")
qor("typed sets ok")
