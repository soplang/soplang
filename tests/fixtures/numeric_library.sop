hawl hubi(v,name){haddii(!v){tuur name}}
hawl near(a,b){celi sugan(a-b)<0.000000000001}
hawl fails(cb,code="E044"){door failed=been tijaabi{cb()}qabo(e,x){failed=run hubi(x.summad==code,"error code")}hubi(failed,"expected failure")}
door pi=joogto("pi")
door e=joogto("e")
hubi(near(joogto("tau"),pi*2) && near(pi,3.141592653589793),"constants")
hubi(near(loog(e),1) && near(loog(1000,10),3) && near(loog(0.25,0.5),2),"logarithms")
hubi(near(sin(pi/2),1) && near(cos(pi),-1) && near(tan(pi/4),1),"radian trigonometry")
hubi(near(sin(1,"rogan"),pi/2) && near(cos(-1,"rogan"),pi) && near(tan(1,"rogan"),pi/4),"inverse trigonometry")
hubi(near(xagal(1,-1),pi*0.75) && near(xagal(-1,-1),-pi*0.75),"quadrants")
hubi(xagal(-0.0,-1)<0 && xagal(0.0,-1)>0,"signed-zero coordinates")
hubi(xadid(5,0,10)==5 && xadid(-1,0,10)==0 && xadid(11,0,10)==10,"clamping")
hubi(nooc(xadid(5,0.0,10.0))=="abn" && nooc(xadid(-1,0.0,10))=="jajab","clamp keeps selected kind")
hubi(xadid(9007199254740993,9007199254740992.0,9223372036854775807)==9007199254740993,"clamp exact large integer comparison")
hubi(yar(9007199254740993,9007199254740995)==9007199254740993,"integer min precision")
hubi(weyn(9007199254740993,9007199254740995)==9007199254740995,"integer max precision")
hubi(yar(-9223372036854775807-1,-9223372036854775807)==-9223372036854775807-1,"minimum endpoint")
hubi(weyn(9223372036854775806,9223372036854775807)==9223372036854775807,"maximum endpoint")
hubi(ugu_yar(9007199254740993,9007199254740995)==9007199254740993 && ugu_weyn(9007199254740993,9007199254740995)==9007199254740995,"legacy extrema")
hubi(nooc(yar(1,2.0))=="jajab" && nooc(weyn(1.0,2))=="jajab","mixed extrema keep existing float result")
door infinity=joogto("inf")
door nan=joogto("nan")
hubi(infinity>1 && !(nan==nan) && loog(infinity)==infinity,"extended float constants")
hubi(xadid(infinity,-infinity,10)==10 && near(tan(infinity,"rogan"),pi/2),"infinite limits")
fails(hawl(){loog(0)})
fails(hawl(){loog(-1)})
fails(hawl(){loog(2,1)})
fails(hawl(){loog(2,infinity)})
fails(hawl(){sin(infinity)})
fails(hawl(){sin(2,"rogan")})
fails(hawl(){cos(-2,"rogan")})
fails(hawl(){tan(1,"bad")})
fails(hawl(){xagal(infinity,1)})
fails(hawl(){joogto("bad")})
fails(hawl(){joogto(1)})
fails(hawl(){xadid(1,2,0)})
fails(hawl(){xadid(nan,0,1)})
fails(hawl(){yar(1,nan)})
fails(hawl(){weyn(nan,1)})
fails(hawl(){loog(run)})
fails(hawl(){sin("1")})
fails(hawl(){abuur(1.0)})
fails(hawl(){abuur(run)})
hubi(abuur(0)==maran,"seed return")
door first=[xul(),xul(),xul()]
abuur(0)
hubi([xul(),xul(),xul()]==first,"reproducible float stream")
abuur(-1)
door negative=[xul(),xul([1,2,3]),xul(-10,10)]
abuur(-1)
hubi([xul(),xul([1,2,3]),xul(-10,10)]==negative,"negative seed and mixed draws")
abuur(1)
door separate=xul()
abuur(2)
hubi(xul()!=separate,"different seeds")
abuur(42)
door choices=[]
kuceli(i ku taxane(100)){choices.geli(xul(["a","b","c"]))}
abuur(42)
door repeated=[]
kuceli(i ku taxane(100)){repeated.geli(xul(["a","b","c"]))}
hubi(choices==repeated && choices.dhammaan(hawl(x){celi ["a","b","c"].leeyahay(x)}),"repeatable choices")
abuur(7)
door expected=xul()
abuur(7)
fails(hawl(){xul([])})
fails(hawl(){xul(3,2)})
fails(hawl(){xul(-infinity,infinity)})
fails(hawl(){xul(nan,1)})
fails(hawl(){xul(run)})
hubi(xul(4,4)==4 && xul()==expected,"invalid and zero-width calls consume no state")
abuur(5)
door largest=jajab("1.7976931348623157e308")
kuceli(i ku taxane(300)){
    door unit=xul()
    door wide=xul(-largest,largest)
    door tiny=xul(1.0,1.0000000000000002)
    hubi(unit>=0 && unit<1 && wide>=-largest && wide<largest && tiny==1.0,"range bounds")
}
hubi([0,pi/2].aaddin(sin).dherer()==2 && [1,e].aaddin(loog).dherer()==2,"native callbacks")
fails(hawl(){[].aaddin(xadid)},"E022")
door math=sin
hubi(near(math(pi/2),1),"first class math function")
hawl factory(){celi hawl(x){celi cos(x)}}
hubi(near(factory()(pi),-1),"math inside closures")
abuur(10)
door next=xul()
abuur(10)
kuceli(i ku taxane(1500)){door waste=[i]}
hubi(xul()==next,"collection does not reset random state")
qor("numeric library ok")
