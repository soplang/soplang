hawl hubi(v,name){haddii(!v){tuur name}}
hawl fails(cb,code="E041"){door failed=been tijaabi{cb()}qabo(e,x){failed=run hubi(x.summad==code,"error code")}hubi(failed,"expected failure")}
urur empty=urur()
hubi(nooc(empty)=="urur" && dherer(empty)==0 && !empty && !bool(empty),"empty set")
urur values=urur(3,1,3,2)
hubi(values.teed()==[3,1,2] && values.xirmo()==xirmo(3,1,2),"insertion order and duplicates")
hubi(dherer(values)==3 && bool(values) && values.dherer()==3,"length and truthiness")
hubi(qaabee(values)=="urur(3, 1, 2)","display")
hubi(values==urur(2,1,3) && values!=urur(3,1) && values!=[3,1,2],"unordered equality")
hubi(values.leeyahay(1) && !values.leeyahay(4),"membership")
door alias=values
hubi(values.geli(4)==values && alias.leeyahay(4),"shared mutation")
values.geli(1)
hubi(values.teed()==[3,1,2,4],"duplicate preserves order")
hubi(values.saar(1)==1 && values.saar(99)==maran,"removal")
values.geli(1)
hubi(values.teed()==[3,2,4,1],"reinsert appends")
door copied=values.nuqul()
copied.saar(3)
hubi(values.leeyahay(3) && !copied.leeyahay(3) && values.urur()==values,"independent copy")
door listed=values.teed()
listed.geli(9)
hubi(!values.leeyahay(9),"list copy")
hubi(values.nadiifi()==empty && alias==empty && copied==urur(2,4,1),"clear aliases")
door left=urur(3,1,2)
door right=urur(2,4)
hubi(left.midee(right).teed()==[3,1,2,4],"union")
hubi(left.wadaag(right).teed()==[2],"intersection")
hubi(left.reeb(right).teed()==[3,1],"difference")
hubi(left.kaladuwan(right).teed()==[3,1,4],"symmetric difference")
hubi(urur(1,2).hoosaad(left) && empty.hoosaad(left) && !left.hoosaad(right),"subset")
hubi(left.midee(left)==left && left.wadaag(left)==left && left.reeb(left)==empty && left.kaladuwan(left)==empty,"self operations")
hubi(left==urur(3,1,2) && right==urur(2,4),"algebra preserves inputs")
door keys=urur(maran,run,been,1,1.0,0.0,-0.0,"x",xirmo(1,"a"),xirmo(1,"a"),xirmo())
hubi(keys.dherer()==9 && keys.leeyahay(xirmo(1,"a")) && keys.leeyahay(-0.0),"key kinds and float normalization")
hubi(urur(1)!=urur(1.0) && urur(run)!=urur(1) && urur(0.0)==urur(-0.0),"strict numeric keys")
hubi(urur(xirmo(1))!=urur(xirmo(1.0)),"tuple numeric kinds")
fails(hawl(){keys.geli([])})
fails(hawl(){keys.geli({})})
fails(hawl(){keys.geli(baytyo())})
fails(hawl(){keys.geli(urur())})
fails(hawl(){keys.geli(xirmo([1]))})
fails(hawl(){keys.geli(hawl(){})})
fails(hawl(){keys.leeyahay([])})
fails(hawl(){keys.saar([])})
fails(hawl(){urur(1,[])})
fails(hawl(){left[0]})
fails(hawl(){left[0]=5})
fails(hawl(){left.a=5})
fails(hawl(){left.unknown()})
fails(hawl(){left.midee([])})
fails(hawl(){left.geli()},maran)
hubi(left==urur(1,2,3),"failed writes preserve values")
hubi([1,1,2].urur()==urur(1,2) && xirmo(1,1,2).urur()==urur(1,2),"sequence conversion")
hubi("å🙂å".urur().teed()==["å","🙂"] && baytyo([1,1,2]).urur()==urur(1,2),"text and bytes conversion")
hubi(urur(xirmo(1,2)).dherer()==1 && teed(left)==[left],"constructors do not expand elements")
door source=urur(1,2,3)
door cursor=source.wareeg()
source.nadiifi().geli(9)
door seen=[]
kuceli(item ku cursor){seen.geli(item)}
hubi(seen==[1,2,3] && cursor.xiga().dhammaad,"snapshot cursor")
door fresh=[]
kuceli(item ku source){fresh.geli(item) source.geli(10)}
hubi(fresh==[9],"loop mutation snapshot")
door rows=[]
kuceli(a,b ku urur(xirmo(1,2),xirmo(3,4))){rows.geli(a+b)}
hubi(rows==[3,7],"tuple row keys")
hubi("aba".wareeg().urur()==urur("a","b"),"iterator conversion")
door adapter=tirso(["a","b"])
fails(hawl(){adapter.urur()})
hubi(adapter.xiga().qiime==[1,"b"],"conversion stops at invalid key")
hawl f(urur input=urur(1)):urur{input.geli(2) celi input}
hubi(f()==urur(1,2) && f()==urur(1,2) && f(input:urur(3))==urur(3,2),"annotations defaults names")
door dynamic=f
fails(hawl(){dynamic([])},"E022")
urur? maybe=maran
maybe=urur(5)
hubi(maybe==urur(5),"optional annotation")
xirmo[urur] holder=xirmo(urur(1))
holder[0].geli(2)
hubi(holder[0]==urur(1,2),"nested bare annotation")
kuceli(i ku baaxad(0,1500)){door garbage=xirmo(urur(xirmo(i))); [garbage]}
hubi(keys.leeyahay(xirmo(1,"a")) && holder[0]==urur(1,2),"GC roots")
qor("sets ok")
