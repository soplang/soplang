# Maintainer: sirrryasir

pkgname=soplang
pkgver={{VERSION}}
pkgrel=1
pkgdesc="The Somali Programming Language (Rust/Cranelift JIT implementation)"
arch=('x86_64' 'aarch64')
url="https://github.com/soplang/soplang"
license=('MIT')
depends=('glibc' 'gcc-libs')
optdepends=('clang: native builds' 'rustup: matching toolchain for native builds')
makedepends=('cargo' 'rust' 'python')
provides=('soplang')
conflicts=('soplang-git' 'soplang-bin')
source=("$pkgname-$pkgver.tar.gz::https://github.com/soplang/soplang/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('{{SHA256}}')

build() {
  cd "$pkgname-$pkgver"
  python scripts/package.py --output dist/soplang
}

# check() {
#   cd "$pkgname-$pkgver"
#   cargo test --release --locked
# }

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "dist/soplang/soplang" "$pkgdir/usr/bin/soplang"
  install -d "$pkgdir/usr/lib"
  cp -R dist/soplang/lib/soplang "$pkgdir/usr/lib/"
  
  # Install license if it exists
  if [ -f "LICENSE" ]; then
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  fi
}
