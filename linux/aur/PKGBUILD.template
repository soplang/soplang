# Maintainer: sirrryasir

pkgname=soplang
pkgver={{VERSION}}
pkgrel=1
pkgdesc="The Somali programming language with JIT and native compilation"
arch=('x86_64')
url="https://github.com/soplang/soplang"
license=('MIT')
depends=('glibc' 'gcc-libs')
provides=('soplang')
conflicts=('soplang-git' 'soplang-bin')
source=("soplang-${pkgver}-linux-x86_64.tar.gz::https://github.com/soplang/soplang/releases/download/v${pkgver}/soplang-${pkgver}-linux-x86_64.tar.gz")
sha256sums=('{{SHA256}}')

package() {
  install -Dm755 "$srcdir/soplang/soplang" "$pkgdir/usr/bin/soplang"
  install -d "$pkgdir/usr/lib/soplang"
  cp -a "$srcdir/soplang/lib/soplang/." "$pkgdir/usr/lib/soplang/"
  install -Dm644 "$srcdir/soplang/LICENSE" "$pkgdir/usr/share/licenses/soplang/LICENSE"
  install -d "$pkgdir/usr/share/licenses/soplang/third-party"
  cp -a "$srcdir/soplang/licenses/." "$pkgdir/usr/share/licenses/soplang/third-party/"
  install -Dm644 "$srcdir/soplang/INSTALLING.md" "$pkgdir/usr/share/doc/soplang/INSTALLING.md"
}
